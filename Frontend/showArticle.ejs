<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.articleTitle %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
</head>
<body>
    
    <header class="header">
        <% if (redirVariable === 'admin') { %>
            <a href="/admin" id="header-title">my blog</a>
            <nav class="nav-bar">
                <div id="header-add">
                    <a href="/add-article">add article</a>
                </div>               
            </nav>
        <% } else { %>
            <a href="/" id="header-title">my blog</a>
        <% } %>
    </header>

    <main class="blog-container">
        <article>
            <div class="article-info">
                <h1 class="article-title"><%= data.articleTitle %></h1>
                <p class="publishing-date">Posted on: <%= data.articleDate %></p>
            </div>
            
            <div class="article-content">
                <p id="data"><%= data.articleContent %></p>
            </div>
        </article>
    </main>
    
    <script src="/toggleMenu.js" defer></script>

</body>
</html>