<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Main Page</title>
    <link rel="stylesheet" href="./styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>

    <body>
        
    <header class="header">
        <a href="/admin" id="header-title">my blog</a>

        <nav class="nav-bar">
            <div id="header-add">
                <a href="/add-article">add article</a>
            </div>               
        </nav>
    </header>

    <main class="list-container">
        
        <% if (articles && articles.length > 0) { %>
            <div id="list">
                <% for (let i = 0; i < articles.length; i++) { %>
                    <article class="article-card">
                        <h3 class="list-h3"> 
                            <a class="list-redirect" href="/article/<%= articles[i].id %>" >
                            <%= articles[i].title %> </a>
                        </h3>
                        <span class="publishing-date-list"> <%= articles[i].date %> </span> 
                    <div class="article-actions">
                        <a href="/edit-article/<%= articles[i].id %>" class="admin-btn">edit</a>

                        <a href="/delete-article/<%= articles[i].id %>" class="admin-btn btn-delete">delete</a>                        
                    </div>                          
                    </article>
 
                <% } %> 
            </div>
        <% } else { %>
            <p class="empty-list">There is nothing to read yet.</p>
        <% } %>

        </main>
    
    <script src="/toggleMenu.js" defer></script>

    </body>
</html>